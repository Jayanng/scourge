# ---- Injective ----
INJECTIVE_NETWORK=testnet
INJECTIVE_CHAIN_ID=injective-888
INJECTIVE_LCD=https://testnet.sentry.lcd.injective.network
INJECTIVE_RPC=https://testnet.sentry.tm.injective.network:443
INJECTIVE_GRPC=testnet.sentry.chain.grpc.injective.network:443

# Prefer private key (64 hex chars, with or without 0x). NEVER commit this file.
DEPLOYER_PRIVATE_KEY=
# Optional: explicit inj1… address (auto-derived from key when using scripts/addr-from-key.mjs)
DEPLOYER_ADDRESS=
# Optional fallback only if you still use seed phrases
# DEPLOYER_MNEMONIC=

# Live testnet (July 2026 deploy) — factory USDC must be a CW20, NEVER the deployer EOA
MARKET_FACTORY_ADDRESS=inj195ussuugvjzxfg2ndqtn8tcyv9r9yw4hmc7kpq
USDC_CW20_ADDRESS=inj18zqkwf7c5ynhcnmx9gg8ty4m6dwqa9pkq6qshs
# DEPRECATED (bad USDC pointer = deployer EOA) — do not use:
# DEPRECATED_FACTORY_ADDRESS=inj12jvr7kwuzue3zmhalu0sg5t6adha58yanjeecv
MARKET_CODE_ID=39702
FACTORY_CODE_ID=39703
CW20_CODE_ID=39704
RESOLVER_ADDRESS=inj1...  # can equal DEPLOYER_ADDRESS for demo

# ---- x402 ----
X402_MODE=mock # or 'live'
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=inj1...
# For X402_MODE=live, a hex private key (EVM) for signing x402 payments
X402_PRIVATE_KEY=
# x402 network (defaults to base-sepolia for testing)
X402_NETWORK=base-sepolia

# ---- CCTP ----
CCTP_SOURCE_CHAIN=base-sepolia
CCTP_DEST_DOMAIN=7
CCTP_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
CCTP_TOKEN_MESSENGER=0x9f3B8679c73C2Fef8b59B4f3444d4e156fb70AA5
CCTP_IRIS_API=https://iris-api-sandbox.circle.com

# ---- LLM ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Sports data ----
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
# REPLAY_MODE=1 uses apps/data/data/replays/*.json (no API keys needed)
REPLAY_MODE=0
REPLAY_SPEED=1
# LIVE_MATCH_IDS=12345,67890
# FIXTURE_FROM=2026-07-03
# FIXTURE_TO=2026-07-19
# POLL_INTERVAL_MS=15000
# DATA_PORT=4001

# ---- Infra ----
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://kickoff:kickoff@localhost:5432/kickoff

# ---- Web ----
# (reads REDIS_URL + DATABASE_URL above)

# ---- Demo orchestrator (Prompt 10) ----
# DEMO_DURATION_MS=45000   # how long the swarm runs before teardown
# REPLAY_LOOP=1            # loop the replay feed

# ---- Agents ----
INSTANCE=1
PERSONA=ronaldo9
# Oracle fault injection (per-instance): wrong | void | offline | lag
FAULT_INJECT=
REPLAY_MODE=0

# ---- Oracle (Prompt 6) ----
RESOLVER_URL=http://localhost:4002
ORACLE_REWARD_PORT=4102        # instance 1 reward sink (4101 base + instance)
ORACLE_SHARED_SECRET=kickoff-oracle-secret
ORACLE_TICK_MS=1000
ORACLE_FAULT_LAG_MS=3000
# ORACLE_NO_DB=1   # skip Postgres persistence

# ---- Resolver (Prompt 7) ----
RESOLVER_PORT=4002
RESOLVER_REWARD_AMOUNT=1000
ORACLE_REWARD_PORT_BASE=4101   # reward sink base (instance i → 4101 + i)
# RESOLVER_MOCK_CHAIN=1  # skip on-chain settle tx (no deployer key)
# RESOLVER_NO_DB=1       # skip Postgres persistence

# ---- Trader (Prompt 8) ----
# PERSONA=ronaldo9|var   (set per instance)
TRADER_PORT=4004
TRADER_BET_AMOUNT=0
SIGNAL_PROVIDER_URL=http://localhost:4002/signals
# TRADER_MOCK_CHAIN=1    # skip on-chain bet tx (no trader key)
# TRADER_NO_DB=1         # skip Postgres persistence
# TRADER_MAX_BETS=0      # 0 = unlimited
